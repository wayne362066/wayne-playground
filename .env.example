APP_NAME=Playground
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Taipei

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=playground
DB_USERNAME=playground
DB_PASSWORD=playground

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=wayne-playground
REVERB_APP_KEY=wayne-playground-local
REVERB_APP_SECRET=wayne-playground-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:5173
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8081
VITE_REVERB_SCHEME=http

LOTTERY_DUEL_CACHE_STORE=redis
LOTTERY_DUEL_ROOM_IDLE_SECONDS=1800
LOTTERY_DUEL_DISCONNECT_WARNING_SECONDS=7
LOTTERY_DUEL_DISCONNECT_FORFEIT_SECONDS=15
LOTTERY_DUEL_HEARTBEAT_SECONDS=5

CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
WISH_ACCESS_MODE=open

# Linux 可設成目前使用者的 id -u / id -g。
APP_UID=1000
APP_GID=1000
